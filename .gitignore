# Custom rule
gemini.md

# Gradle and Java build outputs
.gradle/
backend/.gradle/
backend/build/
backend/out/
backend/bin/
*.class

# Node and Vite build outputs
node_modules/
frontend/node_modules/
frontend/dist/

# IDEs and Editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Log files
*.log

# Spring Boot — perfiles locales con credenciales (NO subir a git)
backend/src/main/resources/application-dev.yml

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# SQL files & DB backups (ignores all .sql files except db_schema.sql)
*.sql
!db/db_schema.sql
!db_schema.sql

# Packages, debug & caches
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
